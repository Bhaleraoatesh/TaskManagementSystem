{
  "ApiName": "TaskManagementAPI",
  "ApiVersion": "v1",
  "BasePath": "/TaskManagement",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
   "JwtSettings": {
    "Key": "YourSuperSecretKeyMustBeAtLeast32CharactersLongForProduction!",
    "Issuer": "TaskManagement.API",
    "Audience": "TaskManagement.Client",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7,
    "RequireHttpsMetadata": true,
    "ClockSkewMinutes": 5
  },
  "AllowedHosts": "*",
  "Swagger": {
    "Enabled": true
  },
  "ConnectionStrings": {
    "TaskManagement": "#{connectionString}"
  },
  "StoredProcedures": {
    "TaskmanagementRepository": {
      "GetAssignedTasks": "sp_GetAssignedTasks",
      "ValidateUser": "ValidateUser"
    }
  },
  "Scripts": {
    "TaskmanagementRepository": {
      "GetAssignedTasks": "GetAssignedTasks.sql"
    }
  }

}
